[Unit]
Description=TGClipboard - Clipboard sync hub
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/tg-clipboard
Restart=on-failure
RestartSec=5
StateDirectory=tg-clipboard
Environment=TG_CLIPBOARD_MAX_HISTORY=50
Environment=TG_CLIPBOARD_TTL=24h
# Optional: expose the hub under a non-default tailnet hostname.
# Environment=TG_CLIPBOARD_HOSTNAME=custom-hub

[Install]
WantedBy=multi-user.target
