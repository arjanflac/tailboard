<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.tg-clipboard.agent</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/local/bin/tg-clipd</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>KeepAlive</key>
	<true/>
	<key>StandardOutPath</key>
	<string>/tmp/tg-clipd.log</string>
	<key>StandardErrorPath</key>
	<string>/tmp/tg-clipd.log</string>
	<!-- Hub is auto-discovered from tailnet. Set TG_CLIPBOARD_HUB to override the URL,
	     or TG_CLIPBOARD_HOSTNAME to discover a non-default hub hostname.
	     Privacy controls are opt-in via environment variables such as
	     TG_CLIPBOARD_IGNORE_APPS, TG_CLIPBOARD_IGNORE_PROCESSES, TG_CLIPBOARD_FILTER_SENSITIVE,
	     and TG_CLIPBOARD_CLEAR_ON_BLOCK. -->
</dict>
</plist>
