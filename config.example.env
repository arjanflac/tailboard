# Copy to config.local.env and fill in values for the local tailnet.
# config.local.env is intentionally ignored. Never commit private hostnames,
# device IDs, signing identities, or machine paths.

TAILBOARD_HUB_URL=http://your-tailboard-hub:9437
TAILBOARD_DESKTOP_NAME=your-mac
TAILBOARD_ANDROID_NAME=your-android-phone
TAILBOARD_IOS_NAME=your-iphone
TAILBOARD_ANDROID_ADB_SERIAL=android-adb-serial
TAILBOARD_IOS_COREDEVICE_ID=ios-coredevice-identifier
TAILBOARD_MAC_CODESIGN_IDENTITY='Apple Development certificate name or SHA-1 hash'
# Optional when it can be read from the signing identity above.
TAILBOARD_APPLE_DEVELOPMENT_TEAM=YOURTEAMID
# Stable Xcode is preferred over a beta for local release-shaped builds.
TAILBOARD_DEVELOPER_DIR=/Applications/Xcode.app/Contents/Developer
